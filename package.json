{
  "name": "clickstack-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ClickStack Observability MCP Server",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build && node scripts/inject-tailwind.mjs",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets",
    "test": "vitest run",
    "test:tools": "node scripts/test-all-tools.mjs",
    "docker:up": "node scripts/setup-docker.mjs",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && node scripts/setup-docker.mjs",
    "docker:status": "docker compose ps"
  },
  "keywords": [
    "nitrostack",
    "mcp",
    "clickstack",
    "observability",
    "metrics",
    "tracing",
    "logs",
    "widgets"
  ],
  "author": "ClickStack Team",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.8.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@nitrostack/core": "^1",
    "dotenv": "^16.3.1",
    "jose": "^5.9.6",
    "lodash": "^4.17.21",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  },
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
