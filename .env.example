# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# Server Transport Configuration
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
MCP_TRANSPORT_TYPE=http
PORT=3000
HOST=0.0.0.0
# ENABLE_CORS=true

# MCP Protocol Version (Optional)
# =============================================================================
# NITRO_MCP_PROTOCOL_VERSION selects which MCP wire revision NitroStack speaks.
# Unset (default) defaults to 'auto' (serves 2026-07-28 stateless with legacy fallback).
#   - auto       : serve both eras from one process (default).
#   - 2026-07-28 : the new stateless spec (server/discover, per-request _meta,
#                  Mcp-Method/Mcp-Name headers, cache hints, MRTR, extensions).
#   - 2025-06-18 : the legacy 2025 sessionful spec.
# Your @Tool/@Resource/@Prompt/@Widget code is identical either way.
# =============================================================================
# NITRO_MCP_PROTOCOL_VERSION=auto

# ClickHouse Configuration
# =============================================================================
# Connection settings for ClickHouse. For local Docker dev use:
#   npm run docker:up
# This starts ClickHouse on localhost:8123 with the 'otel' database pre-seeded.
# =============================================================================
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=otel

# OAuth Configuration
# =============================================================================
# Set OAUTH_REQUIRED=true to enforce OAuth 2.1 token validation on all
# MCP HTTP requests. When false, the OAuth module is not registered.
# =============================================================================
OAUTH_REQUIRED=false
RESOURCE_URI=http://localhost:3000/mcp
AUTH_SERVER_URL=http://localhost:3000/oauth
# JWKS_URI=https://your-auth-server/.well-known/jwks.json
SCOPES_SUPPORTED=observability:read observability:write

# Mapbox Configuration (Optional)
# =============================================================================
# The map widget uses Mapbox GL for interactive maps.
# Get a free API key at: https://www.mapbox.com/
# =============================================================================
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here
